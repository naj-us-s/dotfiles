// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "instrumentation": {
    "performance_profiler": {
      "enabled": false
    }
  },
  "proxy": "",
  "agent_servers": {
    "mistral-vibe": {
      "type": "registry"
    },
    "cursor": {
      "default_config_options": {
        "mode": "plan"
      },
      "type": "registry"
    },
    "codex-acp": {
      "default_config_options": {
        "reasoning_effort": "max",
        "mode": "workspace-write"
      },
      "type": "registry"
    },
    "sigit": {
      "default_config_options": {
        "sigit-model": "bartowski/Qwen2.5-1.5B-Instruct-GGUF"
      },
      "type": "registry"
    },
    "stakpak": {
      "type": "registry"
    },
    "vtcode": {
      "type": "registry"
    },
    "qwen-code": {
      "type": "registry"
    },
    "opencode": {
      "default_config_options": {
        "effort": "low",
        "mode": "build",
        "model": "opencode/beam-free"
      },
      "type": "registry"
    },
    "github-copilot-cli": {
      "type": "registry"
    }
  },
  "vim": {
    "toggle_relative_line_numbers": true
  },
  "autosave": "on_focus_change",
  "vim_mode": true,
  "diff_view_style": "unified",
  "language_models": {
    "opencode": {
      "show_go_models": false,
      "show_zen_models": false
    },
    "llama.cpp": {
      "api_url": "http://127.0.0.1:8080"
    }
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "edit_predictions": {
    "provider": "ollama"
  },
  "agent": {
    "default_profile": "ask",
    "default_model": {
      "effort": "high",
      "provider": "opencode",
      "model": "free/nemotron-3-ultra-free",
      "enable_thinking": true
    },
    "flexible": false,
    "dock": "left",
    "favorite_models": [],
    "model_parameters": [],
  },
  "telemetry": {
    "diagnostics": true,
    "metrics": false,
  },
  "icon_theme": {
    "mode": "dark",
    "light": "Warm Charmed Icons",
    "dark": "Warm Charmed Icons"
  },
  "ui_font_size": 20,
  "buffer_font_size": 19,
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Aura Dark (Soft Text)"
  },
  "theme_overrides": {
    "Aura Dark": {
      "border.variant": "#15141C",
      "border": "#15141C",
      "title_bar.background": "#15141C",
      "panel.background": "#15141C",
      "panel.focused_border": "#4E466E",
      "players": [
        {
          "cursor": "#bd9dff",
        },
      ],
      "syntax": {
        "comment": {
          "font_style": "italic",
        },
        "comment.doc": {
          "font_style": "italic",
        },
      },
    },
  },
  "title_bar": {
    "show_onboarding_banner": false,
    "show_project_items": false,
    "show_branch_name": false,
    "show_user_menu": false,
  },
  "tab_bar": {
    "show": false,
  },
  "toolbar": {
    "quick_actions": false,
  },
  "status_bar": {
    "experimental.show": true,
  },
  "project_panel": {
    "dock": "right",
    "default_width": 500,
    "hide_root": true,
    "auto_fold_dirs": false,
    "starts_open": false,
    "git_status": false,
    "sticky_scroll": false,
    "scrollbar": {
      "show": "never",
    },
  },
  "outline_panel": {
    "dock": "left",
    "default_width": 500,
    "indent_guides": {
      "show": "never",
    },
  },
  "file_finder": {
    "modal_max_width": "large",
  },
  "scrollbar": {
    "show": "never",
  },
  "gutter": {
    "min_line_number_digits": 0,
    "folds": false,
    "runnables": false,
  },
  "ui_font_family": "DankMono Nerd Font",
  "buffer_font_family": "DankMono Nerd Font",
  "buffer_line_height": {
    "custom": 2,
  },
  "agent_buffer_font_size": 20,
  "cursor_blink": false,
  "selection_highlight": false,
  "seed_search_query_from_cursor": "never",
  "show_whitespaces": "none",
  "current_line_highlight": "none",
  "tab_size": 2,
  "auto_indent": "none",
  "auto_indent_on_paste": false,
  "show_completions_on_input": false,
  "show_completion_documentation": false,
  "hover_popover_enabled": false,
  "extend_comment_on_newline": false,
  "horizontal_scroll_margin": 1,
  "vertical_scroll_margin": 1,
}
